# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration (for semantic search embeddings + AI extraction)
OPENAI_API_KEY=your_openai_api_key
# Optional model overrides. The defaults are intentionally pinned in code.
OPENAI_ACTION_MODEL=gpt-4o-mini
OPENAI_RESEARCH_MODEL=gpt-5.4-mini

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PRO_PRICE_ID=your_stripe_pro_price_id
STRIPE_PRO_YEARLY_PRICE_ID=your_stripe_pro_yearly_price_id
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Google OAuth (for Calendar sync + Google Contacts import)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=hello@yourdomain.com
# Required for the approval inbox's signed forwarded-note address.
RESEND_RECEIVING_DOMAIN=inbound.yourdomain.com
RESEND_WEBHOOK_SECRET=your_resend_webhook_signing_secret

# Cron job authentication
CRON_SECRET=your_cron_secret

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sentry Error Monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Separate secrets for different concerns
OAUTH_STATE_SECRET=your_oauth_state_secret
INTERNAL_API_SECRET=your_internal_api_secret
DEV_SECRET=your_dev_secret

# Admin emails (comma-separated)
ADMIN_EMAILS=you@example.com

# RevenueCat (iOS In-App Purchase) — only needed for the native app
NEXT_PUBLIC_REVENUECAT_IOS_KEY=your_revenuecat_public_ios_sdk_key
REVENUECAT_WEBHOOK_AUTH=your_revenuecat_webhook_authorization_secret
# REQUIRED before charging real money: HMAC secret for the signed subscriber
# attribute. If unset in production, Pro grants are blocked (fail closed).
REVENUECAT_ATTRIBUTE_SECRET=your_revenuecat_attribute_hmac_secret
